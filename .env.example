NEXT_PUBLIC_API_BASE_URL=https://your-api-host.com/api
NEXT_PUBLIC_API_URL=https://your-api-host.com
EXCHANGE_API_KEY=your_rotated_exchange_rate_api_key
# Optional internal server URL for server-side requests
API_SERVER_URL=

# Public frontend origin used in canonical links and Article JSON-LD (not the API).
NEXT_PUBLIC_SITE_URL=https://my-news-app-blond-six.vercel.app

# Google web OAuth client (server-only; same client on frontend and backend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
